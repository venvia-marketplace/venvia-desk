{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VenVia Desk",
  "version": "0.4.0-alpha.4",
  "identifier": "it.venvia.desk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VenVia Desk",
        "width": 1000,
        "height": 710,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}